# Celo Mainnet (chainId 42220) — where Proof of Ship metrics (tx / DAU / gas) count.
CELO_RPC_URL=https://forno.celo.org

# Celo Sepolia testnet (chainId 11142220) — for QA/load-testing only (NOT Alfajores).
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# Etherscan V2 API key (one key verifies any chain via ?chainid=). Used for Celoscan too.
CELOSCAN_API_KEY=your_etherscan_v2_api_key

# Deployer key — needs real CELO for gas. Prefer `forge --account <keystore>` over raw keys.
PRIVATE_KEY=0xyour_deployer_private_key

# Optional: owner of LuxeniKeepsake (defaults to deployer). Use a multisig in prod.
# OWNER=
